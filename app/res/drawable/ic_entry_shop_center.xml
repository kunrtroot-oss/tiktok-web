<?xml version="1.0" encoding="utf-8"?>
<!--
  店铺中心：带雨棚的店面外形。
  线稿风格，颜色由 ImageView 的 tint（entry_icon_tint）决定，所以这里统一画成黑色，
  按下时整块线条会跟着变色，不用再维护一套「按下态」图片。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 雨棚：上窄下宽的一条梯形 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M3.2,10.2 L4.8,4.6 L19.2,4.6 L20.8,10.2 Z"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.7" />

    <!-- 店面主体：左右两面墙 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5.6,10.2 L5.6,19.4 L18.4,19.4 L18.4,10.2"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.7" />

    <!-- 门 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M10.2,19.4 L10.2,14.4 L13.8,14.4 L13.8,19.4"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.7" />
</vector>
